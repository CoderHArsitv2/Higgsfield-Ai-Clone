# ---- required ----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5433/higgsfield?sslmode=disable

# Auth0 is the only identity provider. Create an API in Auth0 and use its
# identifier as the audience -- it must match what the frontend requests.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.higgsfield-clone.local

# Encrypts user-supplied provider keys at rest. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ---- optional ----------------------------------------------------------
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
MEDIA_DIR=./.media

# ---- object storage (optional) -----------------------------------------
# Only providers that return raw bytes rather than a URL touch this: OpenAI
# images, Gemini, ElevenLabs. Leave STORAGE_BUCKET empty and those files go to
# MEDIA_DIR on local disk, which is fine locally and wrong anywhere the
# filesystem is ephemeral or there is more than one instance.
#
# Any S3-compatible store works. For Neon Object Storage the endpoint is
# https://br-<branch>.storage.c-2.<region>.aws.neon.tech and the credentials
# come from the Neon API as nak_live_... / nsk_live_...
#
# Use a public_read bucket: the URLs are stored on the asset rows and served
# directly to the browser, so they have to keep working without a signature.
STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only if objects are served from a different host than the S3 endpoint.
STORAGE_PUBLIC_BASE_URL=
STORAGE_PREFIX=generations
WORKER_COUNT=4
POLL_INTERVAL_MS=3000

# ---- provider credentials ----------------------------------------------
# Every model is in the catalogue regardless. A model unlocks when either the
# platform holds the key below, or the signed-in user adds their own.
# The Sandbox provider needs no key and always works.

# One key, most of the catalogue. Start here.
FAL_KEY=
REPLICATE_API_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Set by the deploy workflow on a tagged release. Reported at /health.
APP_VERSION=dev
